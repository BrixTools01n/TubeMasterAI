# TubeMaster AI Environment Configuration
# API keys and sensitive credentials are managed via the Secrets panel in AI Studio.
# Secrets are injected into BuildConfig by the Secrets Gradle Plugin.

GEMINI_API_KEY=MY_GEMINI_API_KEY
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
ADMIN_PASSWORD=MY_ADMIN_PASSWORD
GOOGLE_CLIENT_ID=MY_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=MY_GOOGLE_CLIENT_SECRET
